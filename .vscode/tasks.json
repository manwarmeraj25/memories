{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Memories: run in Safari",
      "type": "shell",
      "command": "python3 scripts/serve.py --port 8000 --browser safari",
      "detail": "Serve the site and open it in Safari. Cmd+Shift+B runs this.",
      "isBackground": true,
      "problemMatcher": [],
      "group": { "kind": "build", "isDefault": true },
      "presentation": { "reveal": "always", "panel": "dedicated" }
    },
    {
      "label": "Memories: serve on the network (phone testing)",
      "type": "shell",
      "command": "python3 scripts/serve.py --port 8000 --browser safari --lan",
      "detail": "Same, but reachable from your phone on the same wi-fi.",
      "isBackground": true,
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "dedicated" }
    },
    {
      "label": "Memories: new year file",
      "type": "shell",
      "command": "python3 scripts/new-year.py ${input:year}",
      "detail": "Create data/years/<year>.json from a template.",
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "dedicated", "clear": true }
    }
  ],
  "inputs": [
    {
      "id": "year",
      "type": "promptString",
      "description": "Which year?",
      "default": "2022"
    }
  ]
}
